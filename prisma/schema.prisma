generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  created
  pending_payment
  confirmed
  processing
  shipped
  canceled

  @@map("order_status")
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
  expired
  refunded
  in_dispute
  chargeback

  @@map("payment_status")
}

enum HistorySource {
  system
  webhook
  admin

  @@map("history_source")
}

model Product {
  id                    Int      @id @default(autoincrement())
  slug                  String   @unique
  sku                   String   @unique
  name                  String
  shortDescription      String?  @map("short_description")
  description           String?
  priceInCents          Int      @map("price_in_cents")
  compareAtPriceInCents Int?     @map("compare_at_price_in_cents")
  currency              String   @default("BRL")
  active                Boolean  @default(true)
  featured              Boolean  @default(false)
  weightGrams           Int?     @map("weight_grams")
  heightCm              Int?     @map("height_cm")
  widthCm               Int?     @map("width_cm")
  lengthCm              Int?     @map("length_cm")
  metaTitle             String?  @map("meta_title")
  metaDescription       String?  @map("meta_description")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  images     ProductImage[]
  orderItems OrderItem[]

  categories  ProductCategory[]
  collections ProductCollection[]
  colors      ProductColor[]

  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String
  thumbUrl  String?  @map("thumb_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Order {
  id                           Int           @id @default(autoincrement())
  publicId                     String        @unique @map("public_id")
  idempotencyKey               String        @unique @map("idempotency_key")
  customerName                 String        @map("customer_name")
  customerEmail                String        @map("customer_email")
  customerPhone                String?       @map("customer_phone")
  customerDocument             String?       @map("customer_document")
  customerNotes                String?       @map("customer_notes")
  status                       OrderStatus   @default(created)
  paymentStatus                PaymentStatus @default(pending) @map("payment_status")
  currency                     String        @default("BRL")
  itemsCount                   Int           @default(0) @map("items_count")
  subtotalInCents              Int           @map("subtotal_in_cents")
  totalInCents                 Int           @map("total_in_cents")
  shippingInCents              Int           @default(0) @map("shipping_in_cents")
  shippingServiceName          String?       @map("shipping_service_name")
  paymentProvider              String        @default("mercadopago") @map("payment_provider")
  sellerNotes                  String?       @map("seller_notes")
  trackingCode                 String?       @map("tracking_code")
  trackingUrl                  String?       @map("tracking_url")
  paidAt                       DateTime?     @map("paid_at") @db.Timestamptz(6)
  shippedAt                    DateTime?     @map("shipped_at") @db.Timestamptz(6)
  cancelledAt                  DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  mercadopagoPreferenceId      String?       @map("mercadopago_preference_id")
  mercadopagoExternalReference String?       @unique @map("mercadopago_external_reference")
  sourceChannel                String        @default("site") @map("source_channel")
  creationEmailStatus String @default("pending") @map("creation_email_status")
  createdAt                    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  items           OrderItem[]
  shippingAddress ShippingAddress?
  payments        Payment[]
  paymentEvents   PaymentEvent[]
  statusHistory   OrderStatusHistory[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id                        Int      @id @default(autoincrement())
  orderId                   Int      @map("order_id")
  productId                 Int?     @map("product_id")
  productNameSnapshot       String   @map("product_name_snapshot")
  productSlugSnapshot       String?  @map("product_slug_snapshot")
  skuSnapshot               String?  @map("sku_snapshot")
  selectedColorId           Int?     @map("selected_color_id")
  selectedColorNameSnapshot String?  @map("selected_color_name_snapshot")
  selectedColorHexSnapshot  String?  @map("selected_color_hex_snapshot")
  unitPriceInCents          Int      @map("unit_price_in_cents")
  quantity                  Int
  lineTotalInCents          Int      @map("line_total_in_cents")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ShippingAddress {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique @map("order_id")
  recipientName String   @map("recipient_name")
  zipCode       String   @map("zip_code")
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  country       String   @default("BR")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipping_addresses")
}

model Payment {
  id                    Int           @id @default(autoincrement())
  orderId               Int           @map("order_id")
  provider              String
  providerPreferenceId  String?       @map("provider_preference_id")
  providerPaymentId     String?       @map("provider_payment_id")
  providerTransactionId String?       @map("provider_transaction_id")
  providerStatus        PaymentStatus @default(pending) @map("provider_status")
  providerStatusDetail  String?       @map("provider_status_detail")
  amountInCents         Int           @map("amount_in_cents")
  currency              String        @default("BRL")
  paymentMethod         String?       @map("payment_method")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(6)
  statusLastSyncedAt    DateTime?     @map("status_last_synced_at") @db.Timestamptz(6)
  rawResponseJson       Json?         @map("raw_response_json")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([providerTransactionId])
  @@index([providerStatus])
  @@map("payments")
}

model PaymentEvent {
  id              Int       @id @default(autoincrement())
  orderId         Int?      @map("order_id")
  provider        String
  eventType       String    @map("event_type")
  providerEventId String?   @map("provider_event_id")
  payloadJson     Json      @map("payload_json")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([orderId])
  @@map("payment_events")
}

model OrderStatusHistory {
  id           Int           @id @default(autoincrement())
  orderId      Int           @map("order_id")
  fromStatus   OrderStatus?  @map("from_status")
  toStatus     OrderStatus   @map("to_status")
  reason       String?
  source       HistorySource @default(system)
  metadataJson Json?         @map("metadata_json")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  active       Boolean  @default(true)
  sessionVersion Int @default(1) @map("session_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products ProductCategory[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Collection {
  id                 Int       @id @default(autoincrement())
  title              String
  slug               String    @unique
  description        String?
  coverImageUrl      String?   @map("cover_image_url")
  coverImageThumbUrl String?   @map("cover_image_thumb_url")
  coverImageAlt      String?   @map("cover_image_alt")
  isActive           Boolean   @default(true) @map("is_active")
  isFeatured         Boolean   @default(false) @map("is_featured")
  sortOrder          Int       @default(0) @map("sort_order")
  startsAt           DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products ProductCollection[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([startsAt])
  @@index([endsAt])
  @@map("collections")
}

model ProductCategory {
  productId  Int      @map("product_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    Int      @map("product_id")
  collectionId Int      @map("collection_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

model StoreSettings {
  id Int @id @default(1)

  storeStatus        String  @default("open") @map("store_status")
  storeClosedMessage String? @map("store_closed_message")

  announcementEnabled   Boolean @default(false) @map("announcement_enabled")
  announcementMessage   String? @map("announcement_message")
  announcementLinkLabel String? @map("announcement_link_label")
  announcementLinkUrl   String? @map("announcement_link_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model FaqItem {
  id Int @id @default(autoincrement())

  question String
  answer   String
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active])
  @@index([position])
  @@map("faq_items")
}

model ProductColor {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  name      String
  hex       String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_colors")
}

model AboutPageSettings {
  id Int @id @default(1)

  // Hero / autora
  authorBadge       String @default("Sobre a autora") @map("author_badge")
  authorTitle       String @default("Oi! Eu sou a Eliadi 👋") @map("author_title")
  authorDescription1 String @db.Text @map("author_description_1")
  authorDescription2 String @db.Text @map("author_description_2")
  authorHighlight    String @default("**Bora tomar um chima!**") @db.Text @map("author_highlight")

  // Fotos da autora
  authorImageMainUrl String? @map("author_image_main_url")
  authorImageMainAlt String? @map("author_image_main_alt")

  authorImageSecondUrl String? @map("author_image_second_url")
  authorImageSecondAlt String? @map("author_image_second_alt")

  authorImageThirdUrl String? @map("author_image_third_url")
  authorImageThirdAlt String? @map("author_image_third_alt")

  // Sobre a Biscuit_eria
  brandBadge        String @default("Sobre a Biscuit_eria") @map("brand_badge")
  brandTitle        String @default("Artesanato que vira lembrança") @map("brand_title")
  brandDescription1 String @db.Text @map("brand_description_1")
  brandDescription2 String @db.Text @map("brand_description_2")

  makerName String @default("Eliadi") @map("maker_name")
  city      String @default("São Leopoldo / RS")
  sinceText String @default("desde 2021") @map("since_text")

  // História
  historyEyebrow     String @default("Nossa história") @map("history_eyebrow")
  historyTitle       String @default("De ideia a peça: um processo com carinho") @map("history_title")
  historySubtitle    String @db.Text @map("history_subtitle")
  historyDescription1 String @db.Text @map("history_description_1")
  historyDescription2 String @db.Text @map("history_description_2")

  // SEO
  metaTitle       String @default("Sobre | Biscuit_eria") @map("meta_title")
  metaDescription String @db.Text @map("meta_description")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("about_page_settings")
}